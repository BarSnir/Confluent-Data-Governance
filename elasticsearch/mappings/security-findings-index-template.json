      "properties": {
        "tenant_id": {"type": "keyword"},
        "asset_id": {"type": "keyword"},
        "device_type": {"type": "keyword"},
        "ip_address": {"type": "ip"},
        "cve_id": {"type": "keyword"},
        "cvss_score": {"type": "float"},
        "severity": {"type": "keyword"},
        "anomaly_score": {"type": "float"},
